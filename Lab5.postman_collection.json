{
  "info": {
    "name": "Lab 5 - HTTP Cat Cache Proxy",
    "description": "Run the requests in order from a fresh cache. Both runs finish with 451 removed. Set the Postman working directory to the repository root for the binary fixture.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET 451 from http.cat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is image/jpeg\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\");",
              "});",
              "pm.test(\"X-Image-Source is http.cat\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"http.cat\");",
              "});",
              "console.info(\"http.cat GET /451:\", pm.response.responseTime, \"ms\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    },
    {
      "name": "GET 451 from cache",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is image/jpeg\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\");",
              "});",
              "pm.test(\"X-Image-Source is cache\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"cache\");",
              "});",
              "console.info(\"cache GET /451:\", pm.response.responseTime, \"ms\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    },
    {
      "name": "PUT local JPEG",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "fixtures/my_image.jpg"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    },
    {
      "name": "GET after PUT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is image/jpeg\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\");",
              "});",
              "pm.test(\"X-Image-Source is cache\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"cache\");",
              "});",
              "pm.test(\"JPEG length matches the PUT fixture\", function () {",
              "    pm.expect(Number(pm.response.headers.get(\"Content-Length\"))).to.eql(Number(pm.collectionVariables.get(\"fixtureBytes\")));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    },
    {
      "name": "DELETE cached JPEG",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    },
    {
      "name": "DELETE absent JPEG",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    },
    {
      "name": "GET absent upstream code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Content-Type is text/plain; charset=utf-8\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"text/plain; charset=utf-8\");",
              "});",
              "pm.test(\"X-Image-Source is absent\", function () {",
              "    pm.expect(pm.response.headers.has(\"X-Image-Source\")).to.be.false;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/299",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "299"
          ]
        }
      }
    },
    {
      "name": "POST unsupported method",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 405\", function () {",
              "    pm.response.to.have.status(405);",
              "});",
              "pm.test(\"Allow lists GET, PUT and DELETE\", function () {",
              "    pm.expect(pm.response.headers.get(\"Allow\")).to.eql(\"GET, PUT, DELETE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/451",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "451"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "fixtureBytes",
      "value": "18062",
      "type": "string"
    }
  ]
}
